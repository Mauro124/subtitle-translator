{
  "manifest_version": 3,
  "name": "Netflix Word Translator",
  "version": "1.0",
  "description": "Translates complex words in Netflix subtitles using a non-invasive overlay.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://www.netflix.com/*"
  ],
  "icons": {
    "16": "assets/icons/icon-192.png",
    "48": "assets/icons/icon-192.png",
    "128": "assets/icons/icon-512.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-192.png",
      "32": "assets/icons/icon-192.png",
      "48": "assets/icons/icon-192.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.netflix.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dictionary.json"],
      "matches": ["*://www.netflix.com/*"]
    }
  ]
}
